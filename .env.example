# Copy this file to .env and replace every placeholder. Never commit .env.
# Optional override example (commented): APP__LOG_LEVEL=DEBUG overrides config/app.yaml.

APP_ENV=development

# PostgreSQL connection strings for two separate roles (brief section 27):
# the application role for app data, and the read-only analytics role for the agent.
APP_DATABASE_URL=postgresql+asyncpg://APP_ROLE:CHANGE_ME@localhost:5432/northwind
ANALYTICS_DATABASE_URL=postgresql+asyncpg://READONLY_ROLE:CHANGE_ME@localhost:5432/northwind

# Signing key for JWT access tokens. Use a long random value.
JWT_SECRET_KEY=CHANGE_ME

# API key for the LLM provider (provider is chosen in a later step).
LLM_API_KEY=CHANGE_ME

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=self-service-data-analyst-agent
