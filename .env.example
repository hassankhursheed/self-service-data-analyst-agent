# Copy this file to .env and replace every placeholder. Never commit .env.
# Optional override example (commented): APP__LOG_LEVEL=DEBUG overrides config/app.yaml.

APP_ENV=development

# PostgreSQL server (Docker Compose) and its owner account. The owner runs the seed script
# and migrations only; the running agent never uses it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=northwind
POSTGRES_USER=northwind_owner
POSTGRES_PASSWORD=CHANGE_ME

# PostgreSQL connection strings for two separate roles (brief section 27):
# the application role for app data, and the read-only analytics role for the agent.
# The seed script creates both roles with the user names and passwords given here.
APP_DATABASE_URL=postgresql+asyncpg://app_rw:CHANGE_ME@localhost:5433/northwind
ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics_ro:CHANGE_ME@localhost:5433/northwind

# Signing key for JWT access tokens. Use a long random value.
JWT_SECRET_KEY=CHANGE_ME

# API key for the LLM provider (provider is chosen in a later step).
LLM_API_KEY=CHANGE_ME

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=self-service-data-analyst-agent

# Demo passwords for the seeded test users (config/test_users.yaml). Demo values only,
# documented for the live demo; never reuse real passwords.
DEMO_PASSWORD_SALES_EUROPE=CHANGE_ME
DEMO_PASSWORD_SALES_AMERICAS=CHANGE_ME
DEMO_PASSWORD_SALES_OTHER=CHANGE_ME
DEMO_PASSWORD_FINANCE=CHANGE_ME
DEMO_PASSWORD_OPERATIONS=CHANGE_ME
DEMO_PASSWORD_ADMIN=CHANGE_ME
DEMO_PASSWORD_NO_ROLE=CHANGE_ME
DEMO_PASSWORD_DISABLED_USER=CHANGE_ME
