# Build context for docker/api.Dockerfile: never send secrets or local state.
.env
.env.*
!.env.example
.git
.venv
**/__pycache__
**/.pytest_cache
.mypy_cache
.ruff_cache
ui
# Only the public Northwind dump, for hosted databases that start empty (--load-northwind).
data/*
!data/northwind
data/northwind/*
!data/northwind/northwind.sql
!data/northwind/LICENSE
docs
tests
# Only the evaluation set and its expected results go into the image.
eval/*
!eval/cases.yaml
!eval/expected
*.md
!README.md
